/* Copyright (c) Jörg Karl-Heinz Walter Brüggmann, 2021-2026
   Author: Jörg Karl-Heinz Walter Brüggmann <info@joerg-brueggmann.de>

   The automation configuration of genc³wb: the notation of an automation script, a gc3s-file,
   and the generator that renders a script in the canonical form the player reads: one line per
   line of the script, the fields of an action separated by tabs, a line that holds no action
   empty, so that the line of an action in the script is the line of its rendering */
syntax
    Script = { Blank }, Head, { Line }, EOS
    Head! = "automation script", LineEnd
    Line = Blank | Action
    Blank = { WHITESPACE }, [ Comment ], NEWLINE
    Comment = "//", { ! NEWLINE, . }
    LineEnd = { WHITESPACE }, [ Comment ], NEWLINE
    Action = Verb, LineEnd
    Verb =
        | Network | BuildSystem | NewNetwork | OpenNode | OpenFile | CloseNode | CloseFile
        | Activate | Deactivate | Edit | Digits | Cursor | Select | Focus | Idle | LongIdle | Delay
        | Mode | Undo | Redo | SettingsFile | Settings | InsertKey | TypingMode | Answer
        | Init | CloseNetwork | Remove | Restore | Verify
    Network! = "network", _, Str
    BuildSystem! = "build system", _, Str
    NewNetwork! = "new network", _, Str
    OpenNode! = "open node", _, Name
    OpenFile! = "open file", _, Str
    CloseNode! = "close node", _, Name
    CloseFile! = "close file", _, Str
    Init! = "init"
    CloseNetwork! = "close network"
    SettingsFile! = "settings file", _, Str
    Remove! = "remove", _, Str
    Activate! = "activate"
    Deactivate! = "deactivate"
    Edit! = "edit", _, Editor, _, Position, _, Number, _, Str
    Digits! = "digits", _, Editor, _, OctetMode, _, Number, _, Number, _, Str
    OctetMode = "hex" | "bin"
    Cursor! = "cursor", _, Editor, _, Position
    Select! = "select", _, Editor, _, Position, _, Position
    Focus! = "focus", _, Target
    Idle! = "idle", _, Editor
    LongIdle! = "long idle", _, Editor
    Delay! = "delay", _, Decimal, _, TimeUnit | "delay", _, Decimal
    TimeUnit = "s" | "ms"
    Mode! = "mode", _, Editor, _, ModeName
    Undo! = "undo", _, Editor
    Redo! = "redo", _, Editor
    Settings! = "settings", _, "idle", _, Decimal, _, "long idle", _, Decimal, _, "automatic", _, Switch, _, "tab size", _, Number, _, "spaces", _, Switch, _, "silent creation", _, Switch, _, "delay", _, DelayValue
    DelayValue = "off" | Decimal
    InsertKey! = "insert key", _, Str
    TypingMode! = "typing mode", _, Typing
    Typing = "insert" | "overwrite"
    Answer! = "answer", _, Dialog
    Dialog = SaveDialog | CreationDialog | FailureDialog
    SaveDialog = "save", _, YesNo
    CreationDialog = "creation", _, Creation
    Creation = "create", _, "silent" | "create" | "cancel"
    FailureDialog = "creation failure", _, Proceed
    YesNo = "yes" | "no"
    Proceed = "continue" | "cancel"
    Restore! = "restore", _, Str, _, "into", _, Str
    Verify! = "verify", _, Editor, _, Str
    Target = Editor | Window
    Window = MainWindow | NodeWindow
    MainWindow = "main"
    NodeWindow = "node", _, Name
    Editor = NetworkEditor | NodeEditor | FileEditor
    NetworkEditor = "network"
    NodeEditor = "node", _, Name, _, Item
    Item = MetaDsl | Input | Output | Diagnostics
    MetaDsl = "dsl"
    Input = "input", _, Number
    Output = "output", _, Number
    Diagnostics = "diagnostics"
    FileEditor = "file", _, Str
    Position = Number, ':', Number
    ModeName = "txt" | "hex" | "bin"
    Switch = "on" | "off"
    Decimal = Number, [ '.', Number ]
    Number! = Digit, { Digit }
    Digit = '0' .. '9'
    Name! = NameChar, { NameChar }
    NameChar = 'a' .. 'z' | 'A' .. 'Z' | '0' .. '9' | '_'
    Str! = '"', { StrChar }, '"'
    StrChar = '\\', . | ! '"', ! NEWLINE, .
generator
    Script -> text(@#0/*) ++ "\n" ++ text(@#2/*)
    Head -> ""
    Line -> #0 | -> #0
    Blank -> "\n"
    Action -> #0 ++ "\n"
    Verb all -> #0
    Network -> "network\t" ++ #2
    BuildSystem -> "build system\t" ++ #2
    NewNetwork -> "new network\t" ++ #2
    OpenNode -> "open node\t" ++ #2
    OpenFile -> "open file\t" ++ #2
    CloseNode -> "close node\t" ++ #2
    CloseFile -> "close file\t" ++ #2
    Activate -> "activate"
    Deactivate -> "deactivate"
    Edit -> "edit\t" ++ #2 ++ "\t" ++ #4 ++ "\t" ++ #6 ++ "\t" ++ #8
    Digits -> "digits\t" ++ #2 ++ "\t" ++ #4 ++ "\t" ++ #6 ++ "\t" ++ #8 ++ "\t" ++ #10
    OctetMode all -> flat
    Cursor -> "cursor\t" ++ #2 ++ "\t" ++ #4
    Select -> "select\t" ++ #2 ++ "\t" ++ #4 ++ "\t" ++ #6
    Focus -> "focus\t" ++ #2
    Idle -> "idle\t" ++ #2
    LongIdle -> "long idle\t" ++ #2
    Delay -> "delay\t" ++ #2 ++ "\t" ++ #4 | -> "delay\t" ++ #2 ++ "\ts"
    TimeUnit all -> flat
    Mode -> "mode\t" ++ #2 ++ "\t" ++ #4
    Undo -> "undo\t" ++ #2
    Redo -> "redo\t" ++ #2
    Settings -> "settings\t" ++ #4 ++ "\t" ++ #8 ++ "\t" ++ #12 ++ "\t" ++ #16 ++ "\t" ++ #20 ++ "\t" ++ #24 ++ "\t" ++ #28
    InsertKey -> "insert key\t" ++ #2
    TypingMode -> "typing mode\t" ++ #2
    Typing all -> flat
    Answer -> "answer\t" ++ #2
    Dialog all -> #0
    SaveDialog -> "save\t" ++ #2
    CreationDialog -> "creation\t" ++ #2
    Creation -> "create\tsilent" | -> "create\t" | -> "cancel\t"
    FailureDialog -> "creation failure\t" ++ #2
    YesNo all -> flat
    Proceed all -> flat
    Init -> "init"
    CloseNetwork -> "close network"
    SettingsFile -> "settings file\t" ++ #2
    Remove -> "remove\t" ++ #2
    Restore -> "restore\t" ++ #2 ++ "\t" ++ #6
    Verify -> "verify\t" ++ #2 ++ "\t" ++ #4
    Target all -> #0
    Window all -> #0
    MainWindow -> "main\t\twindow\t"
    NodeWindow -> "node\t" ++ #2 ++ "\twindow\t"
    Editor all -> #0
    NetworkEditor -> "network\t\t\t"
    NodeEditor -> "node\t" ++ #2 ++ "\t" ++ #4
    FileEditor -> "file\t" ++ #2 ++ "\t\t"
    Item all -> #0
    MetaDsl -> "dsl\t"
    Input -> "input\t" ++ #2
    Output -> "output\t" ++ #2
    Diagnostics -> "diagnostics\t"
    Position -> #0 ++ "\t" ++ #2
    ModeName all -> flat
    Switch all -> flat
    DelayValue all -> flat
    Decimal all -> flat
    Number all -> flat
    Name all -> flat
    Str -> flat(@#1/*)
